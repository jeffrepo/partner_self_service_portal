<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_portal_notifications" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.portal.notifications</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pay_invoice_online_setting_container']" position="inside">
                <setting id="partner_self_service_portal_notifications"
                         string="Notificaciones del portal de clientes"
                         company_dependent="1"
                         help="Notifica solicitudes confirmadas y comprobantes de pago enviados desde el portal.">
                    <div class="content-group">
                        <label for="portal_notification_user_ids"
                               string="Usuarios que recibirán los correos"/>
                        <div class="mt8">
                            <field name="portal_notification_user_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('share', '=', False), ('active', '=', True), ('company_ids', 'in', company_id)]"/>
                        </div>
                        <div class="text-muted">
                            Cada usuario debe estar activo y tener una dirección de correo.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_portal_payment_contacts" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.portal.payment.contacts</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']"
                   position="inside">
                <setting id="partner_self_service_portal_payment_contacts"
                         string="Correos de comprobantes del portal"
                         company_dependent="1"
                         help="Envía a contactos externos una copia del comprobante de pago recibido desde el portal.">
                    <div class="content-group">
                        <label for="portal_payment_notification_partner_ids"
                               string="Contactos que recibirán los correos"/>
                        <div class="mt8">
                            <field name="portal_payment_notification_partner_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('active', '=', True), ('email', '!=', False), ('type', '=', 'contact'), ('user_ids', '=', False)]"/>
                        </div>
                        <div class="text-muted">
                            Solo se muestran contactos con correo que no tienen un usuario de Odoo.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
