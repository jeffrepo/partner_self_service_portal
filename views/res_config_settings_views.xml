<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_portal_notifications" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.portal.notifications</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pay_invoice_online_setting_container']" position="inside">
                <setting id="partner_self_service_portal_notifications"
                         string="Notificaciones del portal de clientes"
                         company_dependent="1"
                         help="Notifica solicitudes confirmadas y comprobantes de pago enviados desde el portal.">
                    <field name="portal_notification_user_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_open': True}"
                           domain="[('share', '=', False), ('active', '=', True), ('company_ids', 'in', company_id)]"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
