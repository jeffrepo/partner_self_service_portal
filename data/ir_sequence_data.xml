<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_portal_order_request" model="ir.sequence">
        <field name="name">Solicitud de compra del portal</field>
        <field name="code">partner.portal.order.request</field>
        <field name="prefix">SPR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_portal_payment_proof" model="ir.sequence">
        <field name="name">Comprobante de pago del portal</field>
        <field name="code">partner.portal.payment.proof</field>
        <field name="prefix">CPP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
